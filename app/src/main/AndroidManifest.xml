<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".ShopExamApp"
        android:usesCleartextTraffic="true"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Shop_Exam">

        <!-- 1. MainActivity - стартовый экран (каталог товаров) -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 2. LoginActivity - экран авторизации -->
        <activity
            android:name=".LoginActivity"
            android:exported="false" />

        <!-- 3. RegisterActivity - обычный экран (ИСПРАВЛЕНО) -->
        <activity
            android:name=".RegisterActivity"
            android:exported="false" />

        <activity
            android:name=".CartActivity"
            android:exported="false" />

        <activity
            android:name=".CheckoutActivity"
            android:exported="false" />

        <activity
            android:name=".OrderSuccessActivity"
            android:exported="false" />

        <activity
            android:name=".MapPickerActivity"
            android:exported="false" />
            
        <activity
            android:name=".GameDetailActivity"
            android:exported="false"
            android:theme="@style/Theme.Shop_Exam.NoActionBar" />

        <activity
            android:name=".ProfileActivity"
            android:exported="false" />

        <activity
            android:name=".OrderDetailActivity"
            android:exported="false" />

        <activity
            android:name=".EditProfileActivity"
            android:exported="false" />
            
    </application>

</manifest>