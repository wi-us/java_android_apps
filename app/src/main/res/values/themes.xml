<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.Lab8" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/color_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/color_secondary</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:colorBackground">@color/color_background</item>
        <item name="android:windowBackground">@color/color_background</item>
        <item name="colorSurface">@color/color_surface</item>
        <item name="colorOnSurface">@color/color_text</item>
        <item name="android:textColorPrimary">@color/color_text</item>
        <item name="android:textColorSecondary">@color/color_text</item>
    </style>

    <style name="Theme.Lab8" parent="Base.Theme.Lab8" />
    <!-- Поля ввода -->
    <style name="Widget.App.TextInputLayout.Base" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/app_space_sm</item>
        <item name="boxBackgroundColor">@color/color_surface</item>
        <item name="boxStrokeColor">@color/color_primary</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.App.CornerRadius</item>
        <item name="android:textAppearance">@style/TextAppearance.App.Body</item>
    </style>
    <style name="Widget.App.TextInputLayout.Login" parent="Widget.App.TextInputLayout.Base" />

    <style name="Widget.App.TextInputEditText.Base" parent="Widget.MaterialComponents.TextInputEditText.OutlinedBox">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/app_input_min_height</item>
        <item name="android:paddingTop">@dimen/app_input_padding_vertical</item>
        <item name="android:paddingBottom">@dimen/app_input_padding_vertical</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textAppearance">@style/TextAppearance.App.Body</item>
    </style>

    <style name="Widget.App.MaterialAutoCompleteTextView.Base" parent="Widget.MaterialComponents.AutoCompleteTextView.OutlinedBox">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/app_input_min_height</item>
        <item name="android:paddingTop">@dimen/app_input_padding_vertical</item>
        <item name="android:paddingBottom">@dimen/app_input_padding_vertical</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textAppearance">@style/TextAppearance.App.Body</item>
    </style>

    <!-- Кнопки -->
    <style name="Widget.App.Button.Base" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_height">@dimen/app_button_height</item>
        <item name="android:gravity">center</item>
        <item name="cornerRadius">@dimen/app_corner_radius</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>
    <style name="Widget.App.Button" parent="Widget.App.Button.Base" />
    <style name="Widget.App.Button.MainButton" parent="Widget.App.Button.Base">
        <item name="android:backgroundTint">@color/color_primary</item>
    </style>
    <style name="Widget.App.Button.SecondaryButton" parent="Widget.App.Button.Base">
        <item name="android:layout_height">@dimen/app_button_height_small</item>
        <item name="android:backgroundTint">@color/color_secondary</item>
    </style>

    <style name="Widget.AppCompat.ImageButton.IconButton" parent="Widget.AppCompat.ImageButton">
        <item name="android:layout_width">24sp</item>
        <item name="android:layout_height">24sp</item>
        <item name="android:gravity">center</item>
        <item name="android:padding">48dp</item>
    </style>

    <!-- Шрифты -->
    <style name="TextAppearance.App._pattern" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/color_text</item>
        <item name="android:textStyle">normal</item>
    </style>

    <style name="TextAppearance.App.Headline" parent="TextAppearance.App._pattern">
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextAppearance.App.Title" parent="TextAppearance.App._pattern">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextAppearance.App.Subtitle" parent="TextAppearance.App._pattern">
        <item name="android:textSize">16sp</item>
    </style>
    <style name="TextAppearance.App.Body" parent="TextAppearance.App._pattern">
        <item name="android:textSize">16sp</item>
    </style>
    <style name="TextAppearance.App.BodySecondary" parent="TextAppearance.App._pattern">
        <item name="android:textSize">14sp</item>
    </style>
    <style name="TextAppearance.App.Caption" parent="TextAppearance.App._pattern">
        <item name="android:textSize">12sp</item>
    </style>

    <style name="Widget.App.Button.AccentButton" parent="Widget.App.Button.Base">
        <item name="backgroundTint">@color/color_secondary</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">@dimen/app_corner_radius</item>
    </style>

    <style name="ShapeAppearance.App.CornerRadius" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/app_corner_radius</item>
    </style>

    <!-- Backward-compat alias: some layouts still reference this name -->
    <style name="ShapeAppearance.App.CornerSize8dp" parent="ShapeAppearance.App.CornerRadius" />

    <!-- Тема без ActionBar для экранов, где мы используем свой Toolbar -->
    <style name="Theme.Lab8.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>
</resources>