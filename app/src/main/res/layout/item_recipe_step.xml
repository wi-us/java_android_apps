<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/app_space_sm"
    app:cardCornerRadius="@dimen/app_corner_radius"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/app_space_md"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/step_number"
            style="@style/TextAppearance.App.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="40dp"
            android:textColor="@color/color_primary"
            tools:text="1" />

        <TextView
            android:id="@+id/step_text"
            style="@style/TextAppearance.App.Body"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/app_space_sm"
            android:lineSpacingExtra="2dp"
            tools:text="Тыкву запечь в духовке до мягкости, размять в пюре." />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
