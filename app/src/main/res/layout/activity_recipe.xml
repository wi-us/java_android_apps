<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="@dimen/app_space_md"
    tools:context=".RecipeActivity">

    <ImageButton
        android:id="@+id/btn_back"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/back"
        android:padding="@dimen/app_icon_margin"
        android:layout_marginStart="@dimen/app_icon_margin"
        android:layout_marginTop="@dimen/app_icon_margin"
        android:src="@drawable/ic_arrow_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/btn_language"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@null"
        android:contentDescription="@string/choose_language"
        android:scaleType="fitCenter"
        android:layout_marginEnd="@dimen/app_icon_margin"
        android:layout_marginTop="@dimen/app_icon_margin"
        android:src="@drawable/ic_globe"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Дубликаты удалены: заголовок, картинка, видео, плеер - только внутри ScrollView -->

    <!-- Круглая кнопка настройки таймеров как студент добавил -->
    <ScrollView
        android:id="@+id/scroll_content"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_language"
        app:layout_constraintVertical_bias="0.0">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/app_space_md"
            android:paddingBottom="@dimen/app_space_lg">

            <!-- Заголовок рецепта теперь внутри скролла -->
            <TextView
                android:id="@+id/recipe_title_scroll"
                style="@style/TextAppearance.App.Headline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/app_space_md"
                tools:text="Пирог из тыквы" />

            <!-- Изображение рецепта внутри скролла -->
            <ImageView
                android:id="@+id/recipe_photo_dish_scroll"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_marginTop="@dimen/app_space_md"
                android:background="@drawable/placeholder_recipe"
                android:scaleType="fitCenter" />

            <!-- Видео внутри скролла -->
            <FrameLayout
                android:id="@+id/recipe_video_container_scroll"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginTop="@dimen/app_space_sm"
                android:visibility="gone">

                <VideoView
                    android:id="@+id/recipe_video_scroll"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </FrameLayout>

            <!-- Кнопка озвучки внутри скролла -->
            <Button
                android:id="@+id/btn_play_voice_scroll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/app_space_sm"
                android:text="@string/play_voice"
                android:visibility="gone" />

            <!-- Таймеры убраны с основной страницы - теперь только в модальном окне -->

            <TextView
                android:id="@+id/label_ingredients"
                style="@style/TextAppearance.App.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/app_space_lg"
                android:text="@string/ingredients" />

            <LinearLayout
                android:id="@+id/ingredients_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/app_space_xs"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/label_steps"
                style="@style/TextAppearance.App.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/app_space_lg"
                android:text="@string/steps" />

            <LinearLayout
                android:id="@+id/steps_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/app_space_xs"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_timer_settings"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:src="@drawable/ic_timer"
        android:contentDescription="Настройка таймеров"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
