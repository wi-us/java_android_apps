<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:paddingTop="@dimen/app_space_md"
    android:paddingBottom="@dimen/app_space_md"
    android:paddingStart="@dimen/app_space_lg"
    android:paddingEnd="@dimen/app_space_lg"
    android:minHeight="@dimen/app_input_min_height">

    <ImageView
        android:id="@+id/language_option_icon"
        android:layout_width="@dimen/language_flag_size"
        android:layout_height="@dimen/language_flag_size"
        android:layout_marginEnd="@dimen/app_space_md"
        android:scaleType="fitCenter"
        android:contentDescription="@null" />

    <TextView
        android:id="@+id/language_option_text"
        style="@style/TextAppearance.App.Body"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="16sp" />
</LinearLayout>
