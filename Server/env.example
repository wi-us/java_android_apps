# Пример файла конфигурации
# Переименуйте в .env и заполните своими значениями

# Секретный ключ для JWT (обязательно измените!)
SECRET_KEY=your_very_long_secret_key_at_least_32_characters

# Время жизни токена в минутах (по умолчанию 30)
TOKEN_EXPIRE_MINUTES=30

# Режим разработки (true/false)
# В продакшене должно быть false
DEBUG=false

# Хост и порт сервера
HOST=0.0.0.0
PORT=8003

# Путь к файлу базы данных
# По умолчанию: ../shop.db (относительно exam_server/)
# Для продакшена укажите абсолютный путь
DATABASE_PATH=/var/www/shop41/shop.db

